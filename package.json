    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
